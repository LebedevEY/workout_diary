{
  "name": "workout-diary-bot",
  "version": "1.0.0",
  "description": "Telegram бот для ведения дневника тренировок",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cd admin-ui && yarn install && yarn build && cd ..",
    "start": "node dist/index.js",
    "dev": "tsx src/bot-start.ts",
    "watch": "tsx watch src/bot-start.ts",
    "admin": "tsx src/admin/index.ts",
    "admin:build": "cd admin-ui && yarn build",
    "admin:dev": "cd admin-ui && yarn dev",
    "bot": "node dist/bot-start.js",
    "admin:prod": "node dist/admin/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "dotenv": "^16.3.1",
    "grammy": "^1.19.2",
    "node-cron": "^3.0.3",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "telegram",
    "bot",
    "workout",
    "diary",
    "sqlite"
  ],
  "author": "",
  "license": "MIT"
}
